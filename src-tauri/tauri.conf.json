{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeNotch",
  "version": "0.1.0",
  "identifier": "dev.codenotch.hud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "hud",
        "title": "CodeNotch",
        "url": "index.html",

        "width": 260,
        "height": 40,
        "minWidth": 120,
        "minHeight": 28,

        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,

        "skipTaskbar": true,
        "focus": false,
        "visible": false,

        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": false }
    },
    "trayIcon": {
      "id": "codenotch-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "tooltip": "CodeNotch",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "CodeNotch contributors",
    "shortDescription": "AI coding-assistant usage HUD",
    "longDescription": "CodeNotch pins a small always-on-top notch to the edge of your screen showing how much of each AI coding assistant's usage limit you have burned, when the window resets, and whether a background agent is generating, finished, or waiting for your approval.",
    "copyright": "Copyright (c) 2026 CodeNotch contributors",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
